rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function stableDoc(stableId) {
      return get(/databases/$(database)/documents/stables/$(stableId));
    }

    function isStableMember(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds;
    }

    function isOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.members[request.auth.uid].role == "admin";
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function isLeavingSelf() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.ownerId != request.auth.uid;
    }

    // Stable-scoped variants of isOwner()/isAdmin(), for use anywhere `resource` is NOT the
    // stable doc itself (i.e. everywhere below except `match /stables/{stableId}`'s own
    // create/update/delete rules) — isOwner()/isAdmin() read `resource.data.ownerId`/
    // `.memberIds`/`.members`, which is only correct when `resource` IS the stable doc.
    function isStableAdmin(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds
        && stableDoc(stableId).data.members[request.auth.uid].role == "admin";
    }

    function isStableOwner(stableId) {
      return signedIn() && stableDoc(stableId).data.ownerId == request.auth.uid;
    }

    function isStableOwnerOrAdmin(stableId) {
      return isStableOwner(stableId) || isStableAdmin(stableId);
    }

    // Per-member fine-grained permissions live on stables/{stableId}/team/{memberId}.permissions
    // (11 boolean keys, mirroring PERMISSION_KEYS in src/lib/permissions.js).
    //
    // Finding WHICH team doc belongs to the caller is the hard part: the client matches by the
    // uid/userId/authUid FIELDS (usePermissions.js), and rules can't search by field — get()
    // only resolves an exact path. Two paths are therefore accepted here:
    //
    //   1. team/{caller uid} — a team doc whose own ID is the caller's uid.
    //   2. memberLinks/{caller uid}.teamMemberId — a pointer doc naming the caller's team doc.
    //
    // (2) exists because team doc IDs are referenced all over the data (classSlots.teacherId,
    // tasks.assignedTo, absences.pid…), so re-keying a team doc to the owner's uid would break
    // every one of those references. The pointer leaves the IDs alone.
    //
    // A member with neither still falls through to defaultPermFor() below — fail-closed in the
    // sense that nothing is silently granted beyond today's defaults, but note that those
    // defaults are BROADER than a restricted member's configured permissions. Linking is what
    // makes the configured permissions real.
    function myTeamDocPath(stableId) {
      return /databases/$(database)/documents/stables/$(stableId)/team/$(request.auth.uid);
    }

    function myLinkPath(stableId) {
      return /databases/$(database)/documents/stables/$(stableId)/memberLinks/$(request.auth.uid);
    }

    function linkedTeamDocPath(stableId) {
      return /databases/$(database)/documents/stables/$(stableId)/team/$(get(myLinkPath(stableId)).data.teamMemberId);
    }

    function hasDirectTeamDoc(stableId) {
      return exists(myTeamDocPath(stableId));
    }

    function hasLinkedTeamDoc(stableId) {
      return exists(myLinkPath(stableId)) && exists(linkedTeamDocPath(stableId));
    }

    function hasTeamDoc(stableId) {
      return hasDirectTeamDoc(stableId) || hasLinkedTeamDoc(stableId);
    }

    function myTeamPerms(stableId) {
      return hasDirectTeamDoc(stableId)
        ? get(myTeamDocPath(stableId)).data.permissions
        : get(linkedTeamDocPath(stableId)).data.permissions;
    }

    // Mirrors defaultTeamPermissions() in src/lib/permissions.js — keep both in sync.
    function defaultPermFor(key) {
      return key in ['horses', 'trainings', 'tasks', 'expenses', 'health'];
    }

    function myPerm(stableId, key) {
      return isStableMember(stableId) && (
        isStableOwnerOrAdmin(stableId)
        || (hasTeamDoc(stableId) && myTeamPerms(stableId)[key] == true)
        || (!hasTeamDoc(stableId) && defaultPermFor(key))
      );
    }

    // A horse's allowedUids field restricts its own profile fields and its expenses
    // subcollection to specific team members, on top of the ordinary myPerm checks above.
    // Absent/null means legacy/unrestricted (every horse predating this feature) — only an
    // explicit array actually narrows access, and admins always bypass it.
    function horseDoc(stableId, hid) {
      return get(/databases/$(database)/documents/stables/$(stableId)/horses/$(hid));
    }

    function isHorseRelated(stableId, hid) {
      let allowed = horseDoc(stableId, hid).data.allowedUids;
      return isStableAdmin(stableId) || allowed == null || request.auth.uid in allowed;
    }

    // True when a team doc has not been claimed by any account yet. Written defensively: a
    // team doc created before the linking fields existed has no uid/userId/authUid key at
    // all, and a bare `data.uid == null` on a missing key denies instead of reading as null.
    function teamDocUnclaimed(d) {
      return (!('uid' in d) || d.uid == null)
        && (!('userId' in d) || d.userId == null)
        && (!('authUid' in d) || d.authUid == null);
    }

    // Lets a non-admin self-link a team doc to their own account — the join-by-code flow
    // (StableSelectionContext.linkUserToTeamMember) writes uid/userId/authUid onto a team doc
    // an admin already created, as the newly-joined (non-admin) user themselves, so the plain
    // admin-only team write rule below would otherwise block the entire self-service join flow.
    //
    // La ficha debe estar sin reclamar O ser ya suya. Sin esa segunda rama, usar un segundo
    // código de invitación para la misma ficha fallaba con "Missing or insufficient
    // permissions": la primera vinculación dejaba la ficha reclamada y la segunda chocaba
    // contra ella. Revincularse con la ficha propia no concede nada nuevo.
    //
    // El resto sigue igual de cerrado que antes: los tres campos solo pueden apuntar al uid
    // de quien escribe (no puedes meter la identidad de otro en esa ficha) y el cambio no
    // puede tocar ninguna clave que no sea de vinculación, así que permissions y role quedan
    // fuera de alcance. Se comprueba con affectedKeys en vez de comparando campo a campo:
    // comparar permissions directamente deniega cuando la ficha ni siquiera tiene ese campo.
    function isSelfLinking(stableId) {
      return isStableMember(stableId)
        && (
          teamDocUnclaimed(resource.data)
          || ('uid' in resource.data && resource.data.uid == request.auth.uid)
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid', 'userId', 'authUid', 'email', 'linkedName', 'linkedAt', 'linkedEmail']);
    }

    // The pointer doc from paragraph (2) above. A member may create their OWN pointer, and
    // only at a team doc that is either still unclaimed or already theirs — so the pointer
    // can't be aimed at a teammate's slot to inherit their permissions. It carries no
    // permissions of its own: everything still comes from the team doc it names.
    function isClaimingOwnLink(stableId, linkUid) {
      return isStableMember(stableId)
        && linkUid == request.auth.uid
        && request.resource.data.teamMemberId is string
        && exists(/databases/$(database)/documents/stables/$(stableId)/team/$(request.resource.data.teamMemberId))
        && (
          teamDocUnclaimed(get(/databases/$(database)/documents/stables/$(stableId)/team/$(request.resource.data.teamMemberId)).data)
          || get(/databases/$(database)/documents/stables/$(stableId)/team/$(request.resource.data.teamMemberId)).data.uid == request.auth.uid
        );
    }

    match /inviteCodes/{code} {
      // `read` cubre dos cosas distintas: leer UN documento (get) y listar la colección
      // entera (list). Con `allow read: if signedIn()` cualquier usuario registrado podía
      // descargarse de golpe todos los códigos de invitación con su stableId asociado.
      // Se permite solo el get: para leer un código hay que saberlo de antemano, que es
      // justo lo que hace joinByCode.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.stableId is string
        && request.auth.uid in stableDoc(request.resource.data.stableId).data.memberIds
        && stableDoc(request.resource.data.stableId).data.members[request.auth.uid].role == "admin";

      // Borrar un código: solo el propietario o un administrador de esa cuadra. La rama
      // del !exists() es para códigos huérfanos, los de una cuadra ya eliminada: deleteStable
      // borra primero la cuadra y después su código, así que para cuando llega aquí la cuadra
      // ya no está y no hay administrador a quien preguntar.
      allow delete: if signedIn()
        && resource.data.stableId is string
        && (
          !exists(/databases/$(database)/documents/stables/$(resource.data.stableId))
          || isStableOwnerOrAdmin(resource.data.stableId)
        );

      allow update: if false;
    }

    match /stables/{stableId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn() && (
        isOwnerOrAdmin()
        || isJoiningSelf()
        || isLeavingSelf()
      );

      allow delete: if isOwnerOrAdmin();

      // Collections gated by the caller's own permission-key matrix (myPerm). Firestore rules
      // are OR-across-every-matching-block, so a wildcard "everything else" rule cannot coexist
      // with these as a looser fallback for the SAME collections — each collection under this
      // stable gets its own explicit block instead (docs/DATABASE.md §4 has the full writeup).
      match /horses/{hid} {
        // Read is deliberately NOT restricted by allowedUids — every stable member keeps
        // reading every horse doc (name, etc.), since boards/tasks/lists depend on that and
        // Firestore can't restrict individual fields within one document. The restriction on
        // a horse's profile fields is a client-side UI gate only (docs/components/horses.md);
        // allowedUids here only ever gates writes.
        allow read: if isStableMember(stableId);

        allow create: if myPerm(stableId, 'horses')
          && (isStableAdmin(stableId)
              || request.resource.data.allowedUids == null
              || request.resource.data.allowedUids == [request.auth.uid]);

        allow update: if myPerm(stableId, 'horses')
          && (request.resource.data.sale == resource.data.sale || myPerm(stableId, 'sale'))
          && (isStableAdmin(stableId)
              || resource.data.allowedUids == null
              || request.auth.uid in resource.data.allowedUids)
          && (request.resource.data.allowedUids == resource.data.allowedUids || isStableAdmin(stableId));

        allow delete: if myPerm(stableId, 'deleteItems');

        // Direct per-horse expense reads, used by the non-admin per-horse listeners in
        // StableDataContext.jsx (see the collectionGroup expenses block below for why
        // non-admins can't use the single stable-wide collectionGroup listener).
        match /expenses/{expenseId} {
          allow read: if isStableMember(stableId) && isHorseRelated(stableId, hid);
        }
      }

      match /tasks/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'tasks');
        allow delete: if myPerm(stableId, 'deleteItems');
      }

      // Non-admin team-doc writes are blocked entirely (not just privileged fields): the
      // client lets ANY member with team:true edit ANY teammate's doc, including .permissions
      // and .role — a privilege-escalation path. Restricting all writes to owner/admin closes
      // it. The one deliberate carve-out is isSelfLinking (above), needed for the join-by-code
      // flow to work for non-admins at all.
      match /team/{memberId} {
        allow read: if isStableMember(stableId);
        allow create, delete: if isStableOwnerOrAdmin(stableId);
        allow update: if isStableOwnerOrAdmin(stableId) || isSelfLinking(stableId);
      }

      // Pointer docs: memberLinks/{uid}.teamMemberId names that account's team doc. Holds no
      // permissions itself — it only tells the rules above where to look.
      match /memberLinks/{linkUid} {
        allow read: if isStableMember(stableId);
        allow create, update: if isStableOwnerOrAdmin(stableId) || isClaimingOwnLink(stableId, linkUid);
        allow delete: if isStableOwnerOrAdmin(stableId) || linkUid == request.auth.uid;
      }

      match /taskTemplates/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'team');
        allow delete: if myPerm(stableId, 'team') && myPerm(stableId, 'deleteItems');
      }

      match /stableExpenses/{eid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'stable');
        allow delete: if myPerm(stableId, 'stable') && myPerm(stableId, 'deleteItems');
      }

      // No client-side permission-key precedent exists for these — membership-only, same as
      // every collection under this stable was before this rules pass.
      match /boardConfig/{docId} {
        allow read, write: if isStableMember(stableId);
      }

      match /sessionAlerts/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /boardAssignments/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /weeklyPlans/{id} {
        allow read, write: if isStableMember(stableId);
      }

      // Notion export. integrations/notion holds only NON-secret ids — the Notion token never
      // goes to Firestore — and is written by an admin when they connect Notion. notionLinks
      // remembers which Notion page each record was sent to, so re-sending updates instead of
      // duplicating; any member with the health permission may sync, hence membership-only.
      match /integrations/{docId} {
        allow read: if isStableMember(stableId);
        allow write: if isStableOwnerOrAdmin(stableId);
      }

      match /notionLinks/{key} {
        allow read, write: if myPerm(stableId, 'health');
      }

      match /periodicBoardDates/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /absences/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /expenseSettlements/{id} {
        allow read, write: if isStableMember(stableId);
      }

      // Modo escuela (boardConfig.schoolMode). Alumnos y clases: mismo criterio
      // membership-only que las demás colecciones de pizarra — quien da la clase necesita
      // poder asignar poni, y no hay clave de permisos propia para esto todavía.
      match /students/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /lessons/{id} {
        allow read, write: if isStableMember(stableId);
      }
    }

    // Collection-group rules for the collections nested under a horse (or a task) that the
    // app queries with collectionGroup() rather than a fixed-ancestor collection() call. Each
    // such document already carries an explicit `stableId` field for exactly this purpose
    // (collectionGroup queries can't filter by ancestor path, only by field), so these rules
    // check that field directly instead of re-deriving the stable from the path.
    match /{path=**}/trainings/{trainingId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'trainings');
      allow update: if myPerm(resource.data.stableId, 'trainings');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/health/{healthId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/healthDocs/{docId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/expenses/{expenseId} {
      // Admin is its own OR branch, not folded into isHorseRelated, so it stays provable from
      // the query's own stableId filter alone: Firestore rejects an entire collectionGroup
      // `list` request outright if the rule can't be proven true for every possible result
      // using only the query's where() clauses. isStableAdmin(...) depends only on
      // resource.data.stableId, which IS the query's filter field. isHorseRelated(...)
      // additionally depends on resource.data.hid, which the query does NOT filter on, so
      // non-admins read expenses through separate per-horse listeners instead.
      allow read: if isStableAdmin(resource.data.stableId)
        || (isStableMember(resource.data.stableId)
            && isHorseRelated(resource.data.stableId, resource.data.hid));
      allow create: if myPerm(request.resource.data.stableId, 'expenses')
        && isHorseRelated(request.resource.data.stableId, request.resource.data.hid);
      allow update: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
      // Deliberately gated by 'expenses' alone, not 'deleteItems': 'expenses' is default-true
      // for new team members, so also requiring deleteItems (default-false) would silently
      // revoke a capability existing non-admin members already have today.
      allow delete: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
    }

    match /{path=**}/occurrences/{date} {
      allow read: if isStableMember(resource.data.stableId);
      allow create, update: if myPerm(request.resource.data.stableId, 'tasks');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}