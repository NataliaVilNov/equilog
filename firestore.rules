rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function stableDoc(stableId) {
      return get(/databases/$(database)/documents/stables/$(stableId));
    }

    function isStableMember(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds;
    }

    function isOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.members[request.auth.uid].role == "admin";
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    // CHANGED: joining a stable now requires proving knowledge of a live invite code.
    // The client must include the code it used as a `joinCode` field in the same update
    // (StableSelectionContext.joinByCode). Without this, any signed-in user who ever knew
    // a stable id could re-add themselves at will.
    function isValidJoinCode(stableId) {
      let code = request.resource.data.get('joinCode', '');
      let path = /databases/$(database)/documents/inviteCodes/$(code);
      return code is string
        && code.size() > 0
        && exists(path)
        && get(path).data.stableId == stableId
        && get(path).data.get('expiresAt', request.time) >= request.time;
    }

    // CHANGED: was only checking memberIds size and a few unchanged fields, which left the
    // `members` map wide open — a joiner could write members[self].role = "admin" in the very
    // same request and take over the stable. Now: only memberIds/members/joinCode may change,
    // only the caller's own key may be touched in `members`, and only with role "member".
    function isJoiningSelf(stableId) {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'members', 'joinCode'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && resource.data.memberIds.toSet()
             .difference(request.resource.data.memberIds.toSet()).size() == 0
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == "member"
        && isValidJoinCode(stableId);
    }

    // CHANGED: same field-level tightening as above, so leaving can't be used to rewrite
    // the members map or demote anyone else on the way out.
    function isLeavingSelf() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'members'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.memberIds.toSet()
             .difference(resource.data.memberIds.toSet()).size() == 0
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && resource.data.ownerId != request.auth.uid;
    }

    function isStableAdmin(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds
        && stableDoc(stableId).data.members[request.auth.uid].role == "admin";
    }

    function isStableOwner(stableId) {
      return signedIn() && stableDoc(stableId).data.ownerId == request.auth.uid;
    }

    function isStableOwnerOrAdmin(stableId) {
      return isStableOwner(stableId) || isStableAdmin(stableId);
    }

    function myTeamDocPath(stableId) {
      return /databases/$(database)/documents/stables/$(stableId)/team/$(request.auth.uid);
    }

    function hasTeamDoc(stableId) {
      return exists(myTeamDocPath(stableId));
    }

    function myTeamPerms(stableId) {
      return get(myTeamDocPath(stableId)).data.permissions;
    }

    function defaultPermFor(key) {
      return key in ['horses', 'trainings', 'tasks', 'expenses', 'health'];
    }

    function myPerm(stableId, key) {
      return isStableMember(stableId) && (
        isStableOwnerOrAdmin(stableId)
        || (hasTeamDoc(stableId) && myTeamPerms(stableId)[key] == true)
        || (!hasTeamDoc(stableId) && defaultPermFor(key))
      );
    }

    function horseDoc(stableId, hid) {
      return get(/databases/$(database)/documents/stables/$(stableId)/horses/$(hid));
    }

    function isHorseRelated(stableId, hid) {
      let allowed = horseDoc(stableId, hid).data.allowedUids;
      return isStableAdmin(stableId) || allowed == null || request.auth.uid in allowed;
    }

    function isSelfLinking(stableId) {
      return isStableMember(stableId)
        && resource.data.uid == null && resource.data.userId == null && resource.data.authUid == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.role == resource.data.role;
    }

    match /inviteCodes/{code} {
      // CHANGED: `get` stays open to any signed-in user (you need the random code string to
      // address the document at all), but `list` is now denied — previously anyone could
      // enumerate every invite code in the database, along with its stableId and name.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.stableId is string
        && request.auth.uid in stableDoc(request.resource.data.stableId).data.memberIds
        && stableDoc(request.resource.data.stableId).data.members[request.auth.uid].role == "admin";

      // CHANGED: was `if signedIn()` — any user could delete any stable's invite codes.
      allow delete: if isStableAdmin(resource.data.stableId);

      allow update: if false;
    }

    match /stables/{stableId} {
      // CHANGED: was `if signedIn()`, which let any registered user list every stable in the
      // app along with its inviteCode and the full members map (names + emails). The
      // array-contains query the stable list page already uses satisfies this rule as-is.
      // Note: the join-by-code screen must now read the stable's name from the inviteCodes
      // doc (it already carries `name`) instead of pre-fetching the stable document.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid].role == "admin";

      allow update: if signedIn() && (
        isOwnerOrAdmin()
        || isJoiningSelf(stableId)
        || isLeavingSelf()
      );

      allow delete: if isOwnerOrAdmin();

      match /horses/{hid} {
        allow read: if isStableMember(stableId);

        allow create: if myPerm(stableId, 'horses')
          && (isStableAdmin(stableId)
              || request.resource.data.allowedUids == null
              || request.resource.data.allowedUids == [request.auth.uid]);

        allow update: if myPerm(stableId, 'horses')
          && (request.resource.data.sale == resource.data.sale || myPerm(stableId, 'sale'))
          && (isStableAdmin(stableId)
              || resource.data.allowedUids == null
              || request.auth.uid in resource.data.allowedUids)
          && (request.resource.data.allowedUids == resource.data.allowedUids || isStableAdmin(stableId));

        allow delete: if myPerm(stableId, 'deleteItems');

        match /expenses/{expenseId} {
          allow read: if isStableMember(stableId) && isHorseRelated(stableId, hid);
        }
      }

      match /tasks/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'tasks');
        allow delete: if myPerm(stableId, 'deleteItems');
      }

      match /team/{memberId} {
        allow read: if isStableMember(stableId);
        allow create, delete: if isStableOwnerOrAdmin(stableId);
        allow update: if isStableOwnerOrAdmin(stableId) || isSelfLinking(stableId);
      }

      match /taskTemplates/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'team');
        allow delete: if myPerm(stableId, 'team') && myPerm(stableId, 'deleteItems');
      }

      match /stableExpenses/{eid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'stable');
        allow delete: if myPerm(stableId, 'stable') && myPerm(stableId, 'deleteItems');
      }

      match /boardConfig/{docId} {
        allow read, write: if isStableMember(stableId);
      }

      match /sessionAlerts/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /boardAssignments/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /weeklyPlans/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /integrations/{docId} {
        allow read: if isStableMember(stableId);
        allow write: if isStableOwnerOrAdmin(stableId);
      }

      match /notionLinks/{key} {
        allow read, write: if myPerm(stableId, 'health');
      }

      match /periodicBoardDates/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /absences/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /expenseSettlements/{id} {
        allow read, write: if isStableMember(stableId);
      }
    }

    match /{path=**}/trainings/{trainingId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'trainings');
      allow update: if myPerm(resource.data.stableId, 'trainings');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/health/{healthId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/healthDocs/{docId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/expenses/{expenseId} {
      allow read: if isStableAdmin(resource.data.stableId)
        || (isStableMember(resource.data.stableId)
            && isHorseRelated(resource.data.stableId, resource.data.hid));
      allow create: if myPerm(request.resource.data.stableId, 'expenses')
        && isHorseRelated(request.resource.data.stableId, request.resource.data.hid);
      allow update: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
      allow delete: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
    }

    match /{path=**}/occurrences/{date} {
      allow read: if isStableMember(resource.data.stableId);
      allow create, update: if myPerm(request.resource.data.stableId, 'tasks');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
