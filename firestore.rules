rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function stableDoc(stableId) {
      return get(/databases/$(database)/documents/stables/$(stableId));
    }

    function isStableMember(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds;
    }

    function isOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.members[request.auth.uid].role == "admin";
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function isLeavingSelf() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.ownerId != request.auth.uid;
    }

    // Stable-scoped variants of isOwner()/isAdmin(), for use anywhere `resource` is NOT the
    // stable doc itself (i.e. everywhere below except `match /stables/{stableId}`'s own
    // create/update/delete rules) — isOwner()/isAdmin() read `resource.data.ownerId`/
    // `.memberIds`/`.members`, which is only correct when `resource` IS the stable doc.
    function isStableAdmin(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds
        && stableDoc(stableId).data.members[request.auth.uid].role == "admin";
    }

    function isStableOwner(stableId) {
      return signedIn() && stableDoc(stableId).data.ownerId == request.auth.uid;
    }

    function isStableOwnerOrAdmin(stableId) {
      return isStableOwner(stableId) || isStableAdmin(stableId);
    }

    // Per-member fine-grained permissions live on stables/{stableId}/team/{memberId}.permissions
    // (11 boolean keys, mirroring PERMISSION_KEYS in src/lib/permissions.js). A team doc is only
    // recognized as "mine" here when its own document ID equals the caller's auth uid — the
    // client additionally matches a doc via uid/userId/authUid fields (usePermissions.js), which
    // rules can't replicate (get() only resolves an exact path, not a field search). Existing
    // team docs (random uid()-generated IDs) won't match until backfilled to use the caller's
    // uid as the doc ID; until then, those members fall through to defaultPermFor()'s defaults
    // instead of their configured permissions — a fail-closed gap, not a fail-open one.
    function myTeamDocPath(stableId) {
      return /databases/$(database)/documents/stables/$(stableId)/team/$(request.auth.uid);
    }

    function hasTeamDoc(stableId) {
      return exists(myTeamDocPath(stableId));
    }

    function myTeamPerms(stableId) {
      return get(myTeamDocPath(stableId)).data.permissions;
    }

    // Mirrors defaultTeamPermissions() in src/lib/permissions.js — keep both in sync.
    function defaultPermFor(key) {
      return key in ['horses', 'trainings', 'tasks', 'expenses', 'health'];
    }

    function myPerm(stableId, key) {
      return isStableMember(stableId) && (
        isStableOwnerOrAdmin(stableId)
        || (hasTeamDoc(stableId) && myTeamPerms(stableId)[key] == true)
        || (!hasTeamDoc(stableId) && defaultPermFor(key))
      );
    }

    // A horse's allowedUids field restricts its own profile fields and its expenses
    // subcollection to specific team members, on top of the ordinary myPerm checks above.
    // Absent/null means legacy/unrestricted (every horse predating this feature) — only an
    // explicit array actually narrows access, and admins always bypass it.
    function horseDoc(stableId, hid) {
      return get(/databases/$(database)/documents/stables/$(stableId)/horses/$(hid));
    }

    function isHorseRelated(stableId, hid) {
      let allowed = horseDoc(stableId, hid).data.allowedUids;
      return isStableAdmin(stableId) || allowed == null || request.auth.uid in allowed;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.stableId is string
        && request.auth.uid in stableDoc(request.resource.data.stableId).data.memberIds
        && stableDoc(request.resource.data.stableId).data.members[request.auth.uid].role == "admin";

      allow delete: if signedIn();

      allow update: if false;
    }

    match /stables/{stableId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn() && (
        isOwnerOrAdmin()
        || isJoiningSelf()
        || isLeavingSelf()
      );

      allow delete: if isOwnerOrAdmin();

      // Collections gated by the caller's own permission-key matrix (myPerm). Firestore rules
      // are OR-across-every-matching-block, so a wildcard "everything else" rule cannot coexist
      // with these as a looser fallback for the SAME collections — each collection under this
      // stable gets its own explicit block instead (docs/DATABASE.md §4 has the full writeup).
      match /horses/{hid} {
        // Read is deliberately NOT restricted by allowedUids — every stable member keeps
        // reading every horse doc (name, etc.), since boards/tasks/lists depend on that and
        // Firestore can't restrict individual fields within one document. The restriction on
        // a horse's profile fields is a client-side UI gate only (docs/components/horses.md);
        // allowedUids here only ever gates writes.
        allow read: if isStableMember(stableId);

        allow create: if myPerm(stableId, 'horses')
          && (isStableAdmin(stableId)
              || request.resource.data.allowedUids == null
              || request.resource.data.allowedUids == [request.auth.uid]);

        allow update: if myPerm(stableId, 'horses')
          && (request.resource.data.sale == resource.data.sale || myPerm(stableId, 'sale'))
          && (isStableAdmin(stableId)
              || resource.data.allowedUids == null
              || request.auth.uid in resource.data.allowedUids)
          && (request.resource.data.allowedUids == resource.data.allowedUids || isStableAdmin(stableId));

        allow delete: if myPerm(stableId, 'deleteItems');

        // Direct per-horse expense reads, used by the non-admin per-horse listeners in
        // StableDataContext.jsx (see the collectionGroup expenses block below for why
        // non-admins can't use the single stable-wide collectionGroup listener). Uses the
        // real path-bound stableId/hid here rather than resource.data fields, so there's no
        // ambiguity about whether Firestore can prove this against the listener's query the
        // way there is for the collectionGroup case.
        match /expenses/{expenseId} {
          allow read: if isStableMember(stableId) && isHorseRelated(stableId, hid);
        }
      }

      match /tasks/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'tasks');
        allow delete: if myPerm(stableId, 'deleteItems');
      }

      // Non-admin team-doc writes are blocked entirely (not just privileged fields): today the
      // client lets ANY member with team:true edit ANY teammate's doc, including .permissions
      // and .role — a privilege-escalation path. Restricting all writes to owner/admin closes it
      // without depending on the doc-ID-equals-uid convention above (which most existing team
      // docs don't satisfy yet).
      match /team/{memberId} {
        allow read: if isStableMember(stableId);
        allow create, update, delete: if isStableOwnerOrAdmin(stableId);
      }

      match /taskTemplates/{tid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'team');
        allow delete: if myPerm(stableId, 'team') && myPerm(stableId, 'deleteItems');
      }

      match /stableExpenses/{eid} {
        allow read: if isStableMember(stableId);
        allow create, update: if myPerm(stableId, 'stable');
        allow delete: if myPerm(stableId, 'stable') && myPerm(stableId, 'deleteItems');
      }

      // No client-side permission-key precedent exists for these — membership-only, same as
      // every collection under this stable was before this rules pass.
      match /boardConfig/{docId} {
        allow read, write: if isStableMember(stableId);
      }

      match /sessionAlerts/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /boardAssignments/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /weeklyPlans/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /periodicBoardDates/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /absences/{id} {
        allow read, write: if isStableMember(stableId);
      }

      match /expenseSettlements/{id} {
        allow read, write: if isStableMember(stableId);
      }
    }

    // Collection-group rules for the collections nested under a horse (or a task) that the
    // app queries with collectionGroup() rather than a fixed-ancestor collection() call. Each
    // such document already carries an explicit `stableId` field for exactly this purpose
    // (collectionGroup queries can't filter by ancestor path, only by field), so these rules
    // check that field directly instead of re-deriving the stable from the path.
    match /{path=**}/trainings/{trainingId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'trainings');
      allow update: if myPerm(resource.data.stableId, 'trainings');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/health/{healthId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/healthDocs/{docId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if myPerm(request.resource.data.stableId, 'health');
      allow update: if myPerm(resource.data.stableId, 'health');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /{path=**}/expenses/{expenseId} {
      // Admin is its own OR branch, not folded into isHorseRelated, so it stays provable from
      // the query's own stableId filter alone: Firestore rejects an entire collectionGroup
      // `list` request outright if the rule can't be proven true for every possible result
      // using only the query's where() clauses — it does not filter non-matching documents
      // out of a list result the way a get() does. isStableAdmin(...) depends only on
      // resource.data.stableId, which IS the query's filter field (StableDataContext.jsx
      // filters this collectionGroup by stableId alone), so an admin's existing single
      // stable-wide listener keeps working unchanged. isHorseRelated(...) additionally
      // depends on resource.data.hid, which the query does NOT filter on — a non-admin's
      // request would fail that same proof, so non-admins read expenses through separate
      // per-horse listeners instead (see docs/DATABASE.md and StableDataContext.jsx).
      allow read: if isStableAdmin(resource.data.stableId)
        || (isStableMember(resource.data.stableId)
            && isHorseRelated(resource.data.stableId, resource.data.hid));
      allow create: if myPerm(request.resource.data.stableId, 'expenses')
        && isHorseRelated(request.resource.data.stableId, request.resource.data.hid);
      allow update: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
      // Deliberately gated by 'expenses' alone, not 'deleteItems': 'expenses' is default-true
      // for new team members, so also requiring deleteItems (default-false) would silently
      // revoke a capability existing non-admin members already have today. Matches current
      // client behavior exactly (see docs/BACKLOG.md).
      allow delete: if myPerm(resource.data.stableId, 'expenses')
        && isHorseRelated(resource.data.stableId, resource.data.hid);
    }

    match /{path=**}/occurrences/{date} {
      allow read: if isStableMember(resource.data.stableId);
      allow create, update: if myPerm(request.resource.data.stableId, 'tasks');
      allow delete: if myPerm(resource.data.stableId, 'deleteItems');
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
