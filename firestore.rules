rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function stableDoc(stableId) {
      return get(/databases/$(database)/documents/stables/$(stableId));
    }

    function isStableMember(stableId) {
      return signedIn()
        && request.auth.uid in stableDoc(stableId).data.memberIds;
    }

    function isOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.members[request.auth.uid].role == "admin";
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function isLeavingSelf() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.ownerId != request.auth.uid;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.stableId is string
        && request.auth.uid in stableDoc(request.resource.data.stableId).data.memberIds
        && stableDoc(request.resource.data.stableId).data.members[request.auth.uid].role == "admin";

      allow delete: if signedIn();

      allow update: if false;
    }

    match /stables/{stableId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn() && (
        isOwnerOrAdmin()
        || isJoiningSelf()
        || isLeavingSelf()
      );

      allow delete: if isOwnerOrAdmin();

      // Every horse/task/health/board/etc. document, at any nesting depth under this
      // stable (horses/{hid}/trainings/{tid}, tasks/{tid}/occurrences/{date}, boardConfig/
      // main, ...), is gated by membership in this stable. This replaces the old
      // `match /data/{doc}` rule, which only covered the single legacy blob document —
      // this recursive match covers that same path too, plus every subcollection the
      // schema migration split it into (docs/DATABASE.md).
      //
      // Exception: this nested match does NOT apply to collectionGroup() queries — Firestore
      // only recognizes a rule for a collectionGroup query if it's declared as its own
      // top-level `match /{path=**}/collectionId/{docId}` block, not nested inside an
      // ancestor's match. trainings/health/healthDocs/expenses/occurrences are all read via
      // collectionGroup() client-side (docs/DATABASE.md §4), so they get their own rules
      // below instead of relying on this block.
      match /{document=**} {
        allow read, write: if isStableMember(stableId);
      }
    }

    // Collection-group rules for the collections nested under a horse (or a task) that the
    // app queries with collectionGroup() rather than a fixed-ancestor collection() call. Each
    // such document already carries an explicit `stableId` field for exactly this purpose
    // (collectionGroup queries can't filter by ancestor path, only by field), so these rules
    // check that field directly instead of re-deriving the stable from the path.
    match /{path=**}/trainings/{trainingId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if isStableMember(request.resource.data.stableId);
      allow update, delete: if isStableMember(resource.data.stableId);
    }

    match /{path=**}/health/{healthId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if isStableMember(request.resource.data.stableId);
      allow update, delete: if isStableMember(resource.data.stableId);
    }

    match /{path=**}/healthDocs/{docId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if isStableMember(request.resource.data.stableId);
      allow update, delete: if isStableMember(resource.data.stableId);
    }

    match /{path=**}/expenses/{expenseId} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if isStableMember(request.resource.data.stableId);
      allow update, delete: if isStableMember(resource.data.stableId);
    }

    match /{path=**}/occurrences/{date} {
      allow read: if isStableMember(resource.data.stableId);
      allow create: if isStableMember(request.resource.data.stableId);
      allow update, delete: if isStableMember(resource.data.stableId);
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
